; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Restaurant Simulator"
config/description="A restaurant management simulation game"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6")

[autoload]

GameState="*res://scripts/autoloads/game_state.gd"
EventManager="*res://scripts/autoloads/event_manager.gd"
MusicManager="*res://scripts/autoloads/music_manager.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=3
window/size/initial_position=0
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/dpi/allow_high_dpi=true

