; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Restaurant Simulator"
config/description="A restaurant management simulation game"
config/features=PackedStringArray("4.5")

[autoload]

GameState="*res://scripts/autoloads/game_state.gd"
EventManager="*res://scripts/autoloads/event_manager.gd"
MusicManager="*res://scripts/autoloads/music_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/size/resizable=true
window/stretch/mode="canvas_items"

